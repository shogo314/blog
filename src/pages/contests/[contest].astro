---
// コンテストごとの記事(解法記事・参加記)の一覧(問題番号順)
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PostList from '../../components/home/PostList.astro';
import { getPosts, groupByContest, navSidebar, type Contest } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const sidebar = navSidebar(posts);
	return groupByContest(posts).map((contest) => ({ params: { contest: contest.slug }, props: { contest, sidebar } }));
}

const { contest, sidebar } = Astro.props as { contest: Contest; sidebar: ReturnType<typeof navSidebar> };
const posts = [...contest.posts].sort((a, b) =>
	(a.data.index ?? '').localeCompare(b.data.index ?? '', 'en', { numeric: true }),
);
---

<StarlightPage
	frontmatter={{ title: contest.name, description: `${contest.site} ${contest.name} の記事`, tableOfContents: false }}
	{sidebar}
>
	<p>{contest.site} · {contest.posts.length} 件</p>
	<PostList posts={posts} />
</StarlightPage>
