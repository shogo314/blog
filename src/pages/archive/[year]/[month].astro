---
// 月ごとの記事の一覧。はてなブログの月別アーカイブのように、カレンダーから日を選べるようにする
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PostList from '../../../components/home/PostList.astro';
import { archiveUrl, getPosts, groupByMonth, navSidebar, postDay, type Month, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const months = groupByMonth(posts);
	const sidebar = navSidebar(posts);
	return months.map((m, i) => ({
		params: { year: String(m.year), month: String(m.month).padStart(2, '0') },
		// months は新しい順なので、1 つ後ろが前の月、1 つ前が次の月
		props: { current: m, prev: months[i + 1], next: months[i - 1], sidebar },
	}));
}

interface Props {
	current: Month;
	prev?: Month;
	next?: Month;
	sidebar: ReturnType<typeof navSidebar>;
}

const { current, prev, next, sidebar } = Astro.props;
const { year, month } = current;
const title = `${year}年${month}月の記事`;

// 日ごとにまとめる(新しい日から順)
const days = new Map<number, Post[]>();
for (const post of current.posts) {
	const { day } = postDay(post);
	if (!days.has(day)) days.set(day, []);
	days.get(day)!.push(post);
}

// カレンダー(日曜始まり)。空欄は 0
const firstWeekday = new Date(Date.UTC(year, month - 1, 1)).getUTCDay();
const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
const cells = [
	...Array(firstWeekday).fill(0),
	...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
while (cells.length % 7) cells.push(0);
const weeks = Array.from({ length: cells.length / 7 }, (_, i) => cells.slice(i * 7, i * 7 + 7));

const monthLabel = (m: Month) => `${m.year}年${m.month}月`;
// 右の目次から日に飛べるようにする
const headings = [...days].map(([day, posts]) => ({ depth: 2, slug: `d${day}`, text: `${month}月${day}日 (${posts.length})` }));
---

<StarlightPage frontmatter={{ title, description: `${year}年${month}月に書いた記事の一覧` }} {sidebar} {headings}>
	<p>
		{current.posts.length} 件 · <a href={archiveUrl()}>月別アーカイブ</a>
	</p>

	<nav class="month-nav" aria-label="前後の月">
		{prev ? <a href={archiveUrl(prev.year, prev.month)}>← {monthLabel(prev)}</a> : <span />}
		{next ? <a href={archiveUrl(next.year, next.month)}>{monthLabel(next)} →</a> : <span />}
	</nav>

	<table class="calendar not-content">
		<thead>
			<tr>{['日', '月', '火', '水', '木', '金', '土'].map((w) => <th>{w}</th>)}</tr>
		</thead>
		<tbody>
			{
				weeks.map((week) => (
					<tr>
						{week.map((day) => (
							<td>
								{day > 0 &&
									(days.has(day) ? (
										<a href={`#d${day}`}>
											{day}
											<span class="count">{days.get(day)!.length}</span>
										</a>
									) : (
										<span class="empty">{day}</span>
									))}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>

	{
		[...days].map(([day, posts]) => (
			<section>
				<h2 id={`d${day}`}>
					{month}月{day}日({posts.length} 件)
				</h2>
				<PostList posts={posts} time />
			</section>
		))
	}
</StarlightPage>

<style>
	.month-nav {
		display: flex;
		justify-content: space-between;
	}
	.calendar {
		display: table;
		width: 100%;
		max-width: 28rem;
		margin-top: 1rem;
		border-collapse: collapse;
		table-layout: fixed;
		text-align: center;
	}
	section h2 {
		font-size: var(--sl-text-h4);
	}
	.calendar th {
		padding: 0.25rem 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: normal;
	}
	.calendar td {
		height: 3rem;
		padding: 0.15rem;
		vertical-align: top;
	}
	.calendar a,
	.calendar .empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 100%;
		border-radius: 0.375rem;
		line-height: 1.3;
	}
	.calendar a {
		background-color: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
		font-weight: 600;
		text-decoration: none;
	}
	.calendar a:hover {
		background-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.calendar .count {
		font-size: var(--sl-text-xs);
		font-weight: normal;
	}
	.calendar .empty {
		color: var(--sl-color-gray-4);
	}
</style>
