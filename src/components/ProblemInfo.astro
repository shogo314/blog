---
import { contestUrlOf } from '../lib/posts';
import { getSiteName } from '../lib/sites';

interface Props {
	problem?: string;
	standalone?: string;
	contest?: string;
	contestUrl?: string;
	index?: string;
	name?: string;
	difficulty?: number;
}

const { problem, standalone, contest, contestUrl, index, name, difficulty } = Astro.props;

// problem か contestUrl のどちらかは必ずある
const siteUrl = (problem ?? contestUrl)!;
const site = getSiteName(siteUrl);
const problemLabel = [index, name].filter(Boolean).join(' - ') || problem;
// AHC(ヒューリスティックコンテスト)の問題には AtCoder Problems の difficulty がない
const isHeuristic = problem !== undefined && /atcoder\.jp\/contests\/ahc\d+\//.test(problem);
---

<dl class="problem-info">
	<dt>サイト</dt>
	<dd>{site}</dd>
	{
		contest && (
			<>
				<dt>コンテスト</dt>
				<dd>
					<a href={contestUrlOf(siteUrl, contest)}>{contest}</a>
					{contestUrl && <>(<a href={contestUrl}>{site} のページ</a>)</>}
				</dd>
			</>
		)
	}
	{
		problem && (
			<>
				<dt>問題</dt>
				<dd>
					<a href={problem}>{problemLabel}</a>
					{standalone && <>(<a href={standalone}>常設版</a>)</>}
				</dd>
			</>
		)
	}
	{
		// 難易度は AtCoder(AtCoder Problems の difficulty)の問題のときだけ表示する。AHC は除く
		problem && site === 'AtCoder' && !isHeuristic && (
			<>
				<dt>難易度</dt>
				<dd>{difficulty ?? '-'}</dd>
			</>
		)
	}
</dl>

<style>
	.problem-info {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.25rem 1.5rem;
		margin-top: 1rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background-color: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
	}
	dt {
		color: var(--sl-color-gray-3);
	}
	dd {
		margin: 0;
	}
</style>
