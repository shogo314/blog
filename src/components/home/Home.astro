---
import ContestList from './ContestList.astro';
import PostList from './PostList.astro';
import TagCloud from './TagCloud.astro';
import { countTags, getPosts, groupByContest, tagUrl } from '../../lib/posts';
import { groupTagsByKind } from '../../lib/tags';

// メインページには一部だけ出し、残りはコンテスト一覧・タグ一覧のページで見られるようにする
const CONTEST_COUNT = 8;
const TAG_COUNT = 8; // 種類ごと

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getPosts();
const recent = posts.slice(0, 10);
const contests = groupByContest(posts);
const tags = countTags(posts);
const tagGroups = await groupTagsByKind(tags);
// 講座(リンク集や、特定の問題を扱わない解説)はタグページで見られるので、ここには出さない
const LINKS_TAG = '講座';
// AHC の参加記には problem があるが、解法記事ではないのでこちらに入れる
const others = posts.filter(
	(post) => (!post.data.problem || post.data.tags?.includes('参加記')) && !post.data.tags?.includes(LINKS_TAG),
);
const linkCount = tags.find(([tag]) => tag === LINKS_TAG)?.[1] ?? 0;
---

<h2>最近の記事</h2>
<PostList posts={recent} />

<div class="columns">
	<section>
		<h2>コンテスト別</h2>
		<ContestList contests={contests.slice(0, CONTEST_COUNT)} />
		<a class="more" href={`${BASE}/contests/`}>すべてのコンテスト({contests.length})→</a>
	</section>
	<section>
		<h2>タグ</h2>
		{
			tagGroups.map((g) => (
				<>
					<h3>{g.label}</h3>
					<TagCloud tags={g.tags.slice(0, TAG_COUNT)} />
				</>
			))
		}
		<a class="more" href={`${BASE}/tags/`}>すべてのタグ({tags.length})→</a>
	</section>
</div>

<h2>解法以外の記事</h2>
<PostList posts={others} />
<a class="more" href={tagUrl(LINKS_TAG)}>講座({linkCount})→</a>

<style>
	.columns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 0 2rem;
	}
	.columns section {
		margin-top: 0;
	}
	.columns h3 {
		margin-top: 1rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.more {
		display: inline-block;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
	}
</style>
